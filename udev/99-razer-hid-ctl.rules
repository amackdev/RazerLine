# Allow members of the "plugdev" group to access Razer HID control
# interfaces without root. Install with:
#
#   sudo cp udev/99-razer-hid-ctl.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   sudo usermod -aG plugdev $USER   # then log out/in
#
# Covers all Razer-vendor USB HID devices (vendor id 1532), not just one
# model, so newly added device profiles don't need a rule change.

SUBSYSTEM=="usb", ATTRS{idVendor}=="1532", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", MODE="0660", GROUP="plugdev", TAG+="uaccess"
